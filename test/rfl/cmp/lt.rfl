;; Invariants for `<`.

;; irreflexive: (< a a) is false
(set A (- (rand 256 200000) 100000))
(count A) -- (sum (not (< A A)))

;; antisymmetric: (< a b) and (< b a) can't both hold
(set B (- (rand 256 200000) 100000))
(count A) -- (sum (not (and (< A B) (< B A))))

;; trichotomy: exactly one of <, >, == holds
(count A) -- (sum (+ (+ (as 'I64 (< A B)) (as 'I64 (> A B))) (as 'I64 (== A B))))

(< 1 2) -- true
(< 2 1) -- false
(< 3 3) -- false
