;; Invariants for `asc` (ascending sort).

(asc [3 1 2]) -- [1 2 3]
(asc [5]) -- [5]
(asc []) -- []

;; length preserved
(set V (rand 200 10000))
(count V) -- (count (asc V))

;; sorted: neighbours obey <=
(set S (asc V))
(set N (- (count S) 1))
N -- (sum (<= (at S (til N)) (at S (+ 1 (til N)))))

;; multiset invariant: sum preserved
(sum V) -- (sum (asc V))

;; first/last
(first (asc V)) -- (min V)
(last (asc V)) -- (max V)

;; idempotent
(asc (asc V)) -- (asc V)
