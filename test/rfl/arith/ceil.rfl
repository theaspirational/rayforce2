;; Invariants for `ceil`.

;; ceil(x) >= x
(set A (div (- (rand 256 10000) 5000) 100))
(count A) -- (sum (>= (ceil A) A))

;; ceil(x) - x is in [0, 1)
(set D (- (ceil A) A))
(count A) -- (sum (and (>= D 0.0) (< D 1.0)))

;; idempotent
(count A) -- (sum (== (ceil (ceil A)) (ceil A)))

;; concrete
(ceil 3.2) -- 4.0
(ceil 3.0) -- 3.0
(ceil -3.7) -- -3.0
