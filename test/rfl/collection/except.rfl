;; Invariants for `except` — set difference.

(except [1 2 3 4 5] [2 4]) -- [1 3 5]
(except [1 2 3] []) -- [1 2 3]
(except [] [1 2]) -- []

;; no element of except(a, b) is in b
(set A (rand 50 20))
(set B (rand 30 20))
(set R (except A B))
(count R) -- (sum (not (in R B)))

;; except(v, v) is empty
(count (except A A)) -- 0

;; ---- Regression tests ported from test_lang_rf.inc::test_rf_except ----
;; Ported from test_lang_rf.inc::test_rf_except.

;; Basic symbol except
(except ['a 'b 'c] ['u 'o]) -- [a b c]
(except ['a 'b 'c] ['a 'c]) -- [b]
(except ['a 'b 'c] ['b]) -- [a c]
(except ['a 'b 'c] ['a 'b 'c]) -- []
;; Integer except
(except [1 2 3 4 5] [2 4]) -- [1 3 5]
(except [1 2 3] [5 6 7]) -- [1 2 3]
(except [10 20 30] [10 30]) -- [20]
(except [1 2 3] [1 2 3]) -- []
;; Empty cases
(except [] [1 2 3]) -- []
(except [1 2 3] []) -- [1 2 3]
(except [] []) -- []
;; Single element except
(except ['x] ['x]) -- []
(except ['x] ['y]) -- [x]
(except [42] [42]) -- []
(except [42] [99]) -- [42]
;; Scalar except vector
(except [1 2 3 4 5] 3) -- [1 2 4 5]
(except ['a 'b 'c] 'b) -- [a c]
(except [1 2 3] 9) -- [1 2 3]
;; Duplicates handling
(except [1 1 2 2 3] [1 3]) -- [2 2]
(except ['a 'a 'b 'c 'c] ['a 'c]) -- [b]
